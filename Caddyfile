:80 {
  encode zstd gzip

  # WebSockets/Socket.IO an Backend
  handle /socket.io/* {
    reverse_proxy app:3000
  }

  # (Optional) REST-API-/health-Routen an Backend
  handle /api/* {
    reverse_proxy app:3000
  }
  handle /healthz {
    reverse_proxy app:3000
  }

  # Alles andere an Frontend
  handle {
    # React Router fallback
    try_files {path} /index.html
    reverse_proxy frontend:80
  }
}
